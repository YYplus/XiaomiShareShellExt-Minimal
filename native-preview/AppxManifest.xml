<?xml version="1.0" encoding="utf-8"?>
<!-- Proof of concept: use the vendor's existing IExplorerCommand without replacing its DLL or registry keys.
     ExternalLocation must be the VERSION directory containing XiaomiPCManager.exe and MiSmartShare/. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  IgnorableNamespaces="uap uap10 rescap com desktop4 desktop5">

  <Identity Name="XiaomiShareNativeMenu.Preview"
            Publisher="CN=XiaomiShareNativeMenuPreview"
            Version="0.1.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>小米原厂互传右键菜单（测试版）</DisplayName>
    <PublisherDisplayName>Local preview</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources><Resource Language="zh-CN" /></Resources>

  <Applications>
    <Application Id="NativeMiDrop"
                 Executable="XiaomiPCManager.exe"
                 uap10:TrustLevel="mediumIL"
                 uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="小米原厂互传右键菜单（测试版）"
        Description="让原厂 MiDropShellExt.dll 的 IExplorerCommand 出现在 Windows 11 一级菜单"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Original Xiaomi MiDrop command">
              <com:Class
                Id="504d69c0-cb52-48df-b5b5-7161829fabc8"
                Path="MiSmartShare\MiDropShellExt.dll"
                ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="NativeMiDropSendFile" Clsid="504d69c0-cb52-48df-b5b5-7161829fabc8" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="NativeMiDropSendDirectory" Clsid="504d69c0-cb52-48df-b5b5-7161829fabc8" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
